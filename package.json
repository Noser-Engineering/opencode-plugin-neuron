{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@noser-engineering/opencode-plugin-neuron",
  "version": "0.3.7",
  "description": "OpenCode plugin that discovers models from configurable LiteLLM proxies with multi-profile support",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./setup": {
      "types": "./dist/setup.d.ts",
      "import": "./dist/setup.js"
    }
  },
  "bin": {
    "opencode-neuron": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "build:binaries": "npm run build && ./scripts/build-binaries.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "opencode",
    "litellm",
    "neuron",
    "noser",
    "plugin",
    "llm-proxy"
  ],
  "author": "Noser Engineering AG",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://dev.azure.com/nosercloud/AI-Experten-Gruppe/_git/opencode-plugin-neuron"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.3",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
